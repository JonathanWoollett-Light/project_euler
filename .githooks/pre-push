#!/bin/sh
# Check every solution in problems/ links its problem, then regenerate
# progress.svg, the solved-problems grid shown in the README, whenever the
# current branch is pushed.
#
# A pre-push hook can't change what the push already under way sends, so when
# the grid changes it is amended into the commit being pushed and this push is
# stopped. Running `git push` again sends the amended commit.
#
# Enable with: git config core.hooksPath .githooks
# Skip with:   git push --no-verify

head=$(git rev-parse --verify -q HEAD)

# A solution without a link is invisible to the grid, so check every pushed
# commit (branches and tags alike), not just HEAD.
pushing_head=
unlinked=
while read -r _ local_oid _ _; do
    case $local_oid in *[!0]*) ;; *) continue ;; esac # all zeros: a deletion
    [ "$local_oid" = "$head" ] && pushing_head=1
    unlinked="$unlinked
$(git grep --no-color -L -E 'projecteuler\.net/problem=[0-9]+' "$local_oid" -- ':(glob)problems/*.py' |
        sed 's/^[^:]*://')"
done
unlinked=$(printf '%s\n' "$unlinked" | sed '/^$/d' | sort -u)
if [ -n "$unlinked" ]; then
    echo "pre-push: these solutions need a first line like # https://projecteuler.net/problem=N" >&2
    printf '%s\n' "$unlinked" | sed 's/^/  /' >&2
    exit 1
fi

# Only redraw the grid when HEAD is being pushed, not for tags or other branches.
[ -n "$pushing_head" ] || exit 0

for python in python3 python py; do
    "$python" -c "" 2>/dev/null && break
    python=
done
if [ -z "$python" ]; then
    echo "pre-push: warning: Python not found, progress grid not updated" >&2
    exit 0
fi
# Stop the push rather than let the grid go stale; `git push --no-verify` skips this.
if ! "$python" scripts/progress_grid.py; then
    echo "pre-push: progress grid not updated, push stopped" >&2
    exit 1
fi

if [ -n "$(git status --porcelain -- progress.svg)" ]; then
    git add -- progress.svg || exit 1
    # Amending a commit a remote already has would fork history, so commit separately then.
    if [ -z "$(git for-each-ref --contains "$head" refs/remotes)" ]; then
        git commit -q --amend --no-edit -- progress.svg || exit 1
        echo "pre-push: amended the updated progress grid into the last commit; run git push again to send it" >&2
    else
        git commit -q -m "Update Project Euler progress grid" -- progress.svg || exit 1
        echo "pre-push: committed the updated progress grid; run git push again to include it" >&2
    fi
    exit 1
fi
